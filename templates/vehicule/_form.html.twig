{% if vehicule.image %}
    <p>
        Photo actuelle :<br>
        <img src="{{ asset('uploads/vehicules/' ~ vehicule.image) }}" alt="Photo actuelle" style="max-width: 200px; border-radius: 6px;">
    </p>
{% endif %}

{{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
