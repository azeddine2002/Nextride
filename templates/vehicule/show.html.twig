{% extends 'base.html.twig' %}

{% block title %}Vehicule{% endblock %}

{% block body %}
    <h1>Vehicule</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ vehicule.id }}</td>
            </tr>
            <tr>
                <th>Marque</th>
                <td>{{ vehicule.marque }}</td>
            </tr>
            <tr>
                <th>Modele</th>
                <td>{{ vehicule.modele }}</td>
            </tr>
            <tr>
                <th>Categorie</th>
                <td>{{ vehicule.categorie.value }}</td>
            </tr>
            <tr>
                <th>PrixJour</th>
                <td>{{ vehicule.prixJour }}</td>
            </tr>
            <tr>
                <th>Disponible</th>
                <td>{{ vehicule.disponible ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ vehicule.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ vehicule.image }}</td>
            </tr>
        </tbody>
    </table>

    {% if vehicule.disponible %}
        <a href="{{ path('app_reservation_new', {'id': vehicule.id}) }}">réserver ce véhicule</a>
    {% endif %}

    <a href="{{ path('app_vehicule_index') }}">back to list</a>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_vehicule_edit', {'id': vehicule.id}) }}">edit</a>

        {{ include('vehicule/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
