{% extends 'base.html.twig' %}

{% block title %}{{ vehicule.marque }} {{ vehicule.modele }} - NextRide{% endblock %}

{% block body %}
    {% set categorieLabels = {'citadine': 'Citadine', 'suv': 'SUV', 'luxe_sportive': 'Luxe / Sportive'} %}

    <div class="fiche-vehicule">
        <div class="photo">Photo du véhicule</div>

        <div class="details">
            <h1>{{ vehicule.marque }} {{ vehicule.modele }}</h1>
            <p class="categorie">{{ categorieLabels[vehicule.categorie.value] }}</p>
            <p class="prix">{{ vehicule.prixJour }}€ / jour</p>

            {% if vehicule.description %}
                <p>{{ vehicule.description }}</p>
            {% endif %}

            <p>Disponibilité : {{ vehicule.disponible ? 'disponible' : 'indisponible' }}</p>

            {% if vehicule.disponible %}
                <a href="{{ path('app_reservation_new', {'id': vehicule.id}) }}" class="btn btn-primary">Réserver ce véhicule</a>
            {% endif %}

            <p><a href="{{ path('app_home') }}">&larr; retour au catalogue</a></p>

            {% if is_granted('ROLE_ADMIN') %}
                <hr>
                <a href="{{ path('app_vehicule_edit', {'id': vehicule.id}) }}" class="btn btn-secondary">modifier</a>
                {{ include('vehicule/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
{% endblock %}
