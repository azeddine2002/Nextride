{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block body %}
<div class="page-contenu">
    <h1>Mes réservations</h1>

    {% for message in app.flashes('success') %}
        <div class="alerte alerte-succes">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alerte alerte-erreur">{{ message }}</div>
    {% endfor %}

    <table class="table">
        <thead>
            <tr>
                <th>Véhicule</th>
                <th>Date début</th>
                <th>Date fin</th>
                <th>Statut</th>
                <th>Paiement</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.vehicule.marque }} {{ reservation.vehicule.modele }}</td>
                <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                <td>{{ reservation.statut.value }}</td>
                <td>{{ reservation.paye ? 'Payé' : 'Non payé' }}</td>
                <td>
                    {% if reservation.paye %}
                        <a href="{{ path('app_reservation_recu', {'id': reservation.id}) }}" class="btn btn-secondary">Reçu</a>
                    {% endif %}
                    {% if reservation.statut.value == 'en_cours' %}
                        {% if not reservation.paye %}
                            <a href="{{ path('app_reservation_payer', {'id': reservation.id}) }}" class="btn btn-primary">Payer</a>
                        {% endif %}
                        <form method="post" action="{{ path('app_reservation_cancel', {'id': reservation.id}) }}" onsubmit="return confirm('Annuler cette réservation ?');" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ reservation.id) }}">
                            <button type="submit" class="btn btn-danger">Annuler</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucune réservation</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <p><a href="{{ path('app_home') }}">&larr; voir les véhicules</a></p>
</div>
{% endblock %}
