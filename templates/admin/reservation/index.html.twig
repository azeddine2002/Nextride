{% extends 'base.html.twig' %}

{% block title %}Administration - Réservations{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'admin/_sidebar.html.twig' %}

    <div class="admin-content">
        <h1>Réservations</h1>

        {% for message in app.flashes('success') %}
            <div class="alerte alerte-succes">{{ message }}</div>
        {% endfor %}

        <table class="table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Véhicule</th>
                    <th>Date début</th>
                    <th>Date fin</th>
                    <th>Statut</th>
                    <th>Paiement</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.utilisateur.prenom }} {{ reservation.utilisateur.nom }}</td>
                    <td>{{ reservation.vehicule.marque }} {{ reservation.vehicule.modele }}</td>
                    <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                    <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                    <td>{{ reservation.statut.value }}</td>
                    <td>{{ reservation.paye ? 'Payé' : 'Non payé' }}</td>
                    <td>
                        {% if reservation.statut.value == 'en_cours' %}
                            <form method="post" action="{{ path('app_admin_reservation_cancel', {'id': reservation.id}) }}" onsubmit="return confirm('Annuler cette réservation ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin-annuler' ~ reservation.id) }}">
                                <button type="submit" class="btn btn-danger">Annuler</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucune réservation enregistrée</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
