{% extends 'base.html.twig' %}

{% block title %}Administration - Utilisateurs{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'admin/_sidebar.html.twig' %}

    <div class="admin-content">
        <h1>Utilisateurs</h1>

        {% for message in app.flashes('success') %}
            <div class="alerte alerte-succes">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alerte alerte-erreur">{{ message }}</div>
        {% endfor %}

        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Inscrit le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for utilisateur in utilisateurs %}
                <tr>
                    <td>{{ utilisateur.prenom }} {{ utilisateur.nom }}</td>
                    <td>{{ utilisateur.email }}</td>
                    <td>{{ utilisateur.roles|join(', ') }}</td>
                    <td>{{ utilisateur.dateInscription|date('d/m/Y') }}</td>
                    <td>
                        {% if utilisateur != app.user %}
                            <form method="post" action="{{ path('app_admin_utilisateur_delete', {'id': utilisateur.id}) }}" onsubmit="return confirm('Supprimer cet utilisateur et ses réservations ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-utilisateur' ~ utilisateur.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun utilisateur enregistré</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
