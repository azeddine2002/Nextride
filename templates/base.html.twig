<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}NextRide{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@700&display=swap" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="logo" href="{{ path('app_home') }}">NextRide</a>
            <nav>
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_home') }}#catalogue">Véhicules</a>
                {% if app.user %}
                    <a href="{{ path('app_reservation_index') }}">Mes réservations</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_vehicule_index') }}">Administration</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                {% endif %}
            </nav>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            NextRide © {{ "now"|date('Y') }}
            | <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
            | <a href="{{ path('app_confidentialite') }}">Politique de confidentialité (RGPD)</a>
            | <a href="mailto:contact@nextride.fr">Contact</a>
        </footer>
    </body>
</html>
